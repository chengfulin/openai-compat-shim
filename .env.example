# Upstream OpenAI-compatible server
UPSTREAM_BASE_URL=http://192.168.x.x:8000

# Used only when the caller sends no Authorization header of its own.
# UPSTREAM_API_KEY=sk-...

# Client-facing -> upstream API key mappings, e.g. the customer's key -> the
# internal vLLM key. Keys not in the table are forwarded as-is.
# API_KEY_MAP={"sk-customer-key":"sk-internal-key"}

# Extra client-facing -> upstream name mappings, merged over the built-in
# {"gemma4-26b": "Gemma-4-26B-A4B"}
# MODEL_ALIASES={"gemma4":"Gemma-4-26B-A4B"}

# CONNECT_TIMEOUT=10
# READ_TIMEOUT=600
